# Supabase Configuration
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend API Configuration
VITE_API_BASE_URL=http://localhost:3001

# Socket.IO Configuration
VITE_SOCKET_URL=http://localhost:3000

# Stream Chat Configuration
VITE_STREAM_API_KEY=your-stream-api-key
VITE_STREAM_API_SECRET=your-stream-api-secret

# Google Maps Configuration
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# SMS Configuration (for Vercel deployment)
SMS_SERVER=https://your-sms-provider-api.com/send
SMS_USERNAME=your-sms-username
SMS_PASSWORD=your-sms-password

# Legacy SMS Configuration (for local development with smsgate)
ASG_USERNAME=your-asg-username
ASG_PASSWORD=your-asg-password
ASG_SERVER=your-asg-server
